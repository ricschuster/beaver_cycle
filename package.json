{
  "name": "beaver-cycle",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:devtools": "tsc --noEmit && vite build --mode devtools",
    "check:release": "node scripts/check-release.mjs",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:release": "npm run build && playwright test -c playwright.release.config.ts",
    "host-bridge": "node tools/host-bridge/bridge.mjs",
    "stress": "node tools/stress/stress.mjs"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "ws": "^8.22.0"
  }
}
